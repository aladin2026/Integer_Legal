{
  "realm": "integer-local",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "clients": [{
    "clientId": "integer-legal-web",
    "name": "Integer Legal Web (local)",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["http://localhost:3000/*"],
    "webOrigins": ["http://localhost:3000"],
    "attributes": { "pkce.code.challenge.method": "S256" },
    "protocolMappers": [
      {
        "name": "integer-legal-audience",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-audience-mapper",
        "consentRequired": false,
        "config": { "included.custom.audience": "integer-legal-api", "access.token.claim": "true" }
      },
      {
        "name": "integer-tenant",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": { "user.attribute": "integer_tenant", "claim.name": "integer_tenant", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true" }
      },
      {
        "name": "integer-permissions",
        "protocol": "openid-connect",
        "protocolMapper": "oidc-usermodel-attribute-mapper",
        "consentRequired": false,
        "config": { "user.attribute": "integer_permission", "claim.name": "integer_permission", "jsonType.label": "String", "multivalued": "true", "access.token.claim": "true" }
      }
    ]
  }],
  "users": [
    {
      "id": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
      "username": "associe.a",
      "enabled": true,
      "firstName": "Associé",
      "lastName": "Cabinet Atlas",
      "attributes": {
        "integer_tenant": ["11111111-1111-4111-8111-111111111111"],
        "integer_permission": ["legal.read", "legal.write", "legal.finance", "legal.admin"]
      },
      "credentials": [{ "type": "password", "value": "Local-A-2026!", "temporary": false }]
    },
    {
      "id": "bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb",
      "username": "avocat.b",
      "enabled": true,
      "firstName": "Avocat",
      "lastName": "Cabinet Rif",
      "attributes": {
        "integer_tenant": ["22222222-2222-4222-8222-222222222222"],
        "integer_permission": ["legal.read"]
      },
      "credentials": [{ "type": "password", "value": "Local-B-2026!", "temporary": false }]
    }
  ]
}
